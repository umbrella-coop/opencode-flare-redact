{
  "name": "@umbrella-coop/flare-redact-opencode",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: redact secrets/PII before they reach the model",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@umbrella-coop/flare-redact-core": "workspace:*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.14",
    "@opencode-ai/sdk": "^1.18.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}