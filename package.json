{
  "name": "@umbrella-coop/flare-redact-ai-code-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-assistant secret/PII redaction guard for AI coding assistants, powered by flare-redact",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs",
    "cut-release": "node scripts/cut-release.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "review-security": "flare-redact --scan . --exclude package-lock.json --exclude pnpm-lock.yaml --exclude .opencode --exclude .standards --exclude test --exclude dist --exclude '**/plugin/scripts'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "flare-redact": "1.4.1",
    "typescript": "~5.9.3"
  }
}
